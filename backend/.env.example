BLACKBOX_ENVIRONMENT=development
# Relative SQLite paths are resolved against backend/, independently of the shell cwd.
BLACKBOX_DATABASE_URL=sqlite:///./data/blackbox.db
BLACKBOX_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Opt-in: only the bundled, intercepted demo; no arbitrary local or remote URLs.
BLACKBOX_DEMO_TESTING_ENABLED=false
# AI: rules always work locally. External mode also requires consent per analysis.
BLACKBOX_AI_PROVIDER=disabled
BLACKBOX_AI_MODEL=
# Keep the key only in backend/.env or the backend process environment.
BLACKBOX_AI_API_KEY=
BLACKBOX_AI_TIMEOUT_SECONDS=30
BLACKBOX_AI_MAX_RETRIES=1
BLACKBOX_AI_MAX_OUTPUT_TOKENS=2000
BLACKBOX_AI_DAILY_CALL_LIMIT=10
BLACKBOX_AI_RUN_CALL_LIMIT=2
BLACKBOX_AI_DAILY_TOKEN_LIMIT=100000
BLACKBOX_AI_COOLDOWN_SECONDS=60
# Optional USD prices per million tokens; set both before enabling a money budget.
# BLACKBOX_AI_INPUT_USD_PER_MILLION=...
# BLACKBOX_AI_OUTPUT_USD_PER_MILLION=...
# BLACKBOX_AI_DAILY_BUDGET_USD=...
